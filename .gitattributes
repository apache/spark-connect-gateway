# Normalize line endings to LF on checkin, and let Git decide what is text.
* text=auto eol=lf

# Third-party license files are kept byte-for-byte as their crates ship them
# (some use CRLF); dev/check-license-binary.py compares them byte-for-byte.
licenses-binary/** -text

# Explicitly treat common binary types as binary (never normalize/diff).
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.gz binary
*.tgz binary
